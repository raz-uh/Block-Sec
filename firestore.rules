rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown routes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'xp']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.xp is int && data.xp >= 0 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('rank' in data) || (data.rank is string && data.rank.size() <= 64)) &&
        (!('completedChallenges' in data) || (data.completedChallenges is list && data.completedChallenges.size() <= 500)) &&
        (!('unlockedHints' in data) || (data.unlockedHints is list && data.unlockedHints.size() <= 1000)) &&
        (!('badges' in data) || (data.badges is list && data.badges.size() <= 100));
    }

    // Connection testing doc
    match /test/{testId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == request.auth.uid &&
        isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == existing().userId &&
        isValidUserProfile(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
